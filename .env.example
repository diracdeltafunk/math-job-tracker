# Used by the Cloudflare Vite build. The database and account IDs are not secrets.
CLOUDFLARE_WORKER_NAME=academic-job-tracker
CLOUDFLARE_D1_DATABASE_NAME=academic-job-tracker
CLOUDFLARE_D1_DATABASE_ID=replace-with-your-d1-database-id
# Optional for local triage. Use the TRIAGE_PROFILE GitHub Actions secret in production.
TRIAGE_PROFILE="Describe your job-search preferences here."
